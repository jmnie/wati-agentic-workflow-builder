# =====================================================================
# LLM configuration
# =====================================================================
# Pick a provider. Switching providers is just changing these env vars —
# no code change needed.
#
#   anthropic  → native Claude API (supports prompt caching)
#   openai     → ANY OpenAI-compatible endpoint (OpenAI, DeepSeek,
#                Moonshot, Together, Groq, OpenRouter, Ollama, vLLM, …)
#
LLM_PROVIDER=anthropic

# API key for the chosen provider.
# Backwards-compat: if LLM_API_KEY is unset, ANTHROPIC_API_KEY is used
# when provider=anthropic, OPENAI_API_KEY when provider=openai.
LLM_API_KEY=

# Optional: override the base URL. Only meaningful for provider=openai.
# Examples (uncomment ONE):
# LLM_BASE_URL=https://api.openai.com/v1                 # OpenAI (default)
# LLM_BASE_URL=https://api.deepseek.com/v1               # DeepSeek
# LLM_BASE_URL=https://api.moonshot.cn/v1                # Moonshot (Kimi)
# LLM_BASE_URL=https://api.together.xyz/v1               # Together AI
# LLM_BASE_URL=https://api.groq.com/openai/v1            # Groq
# LLM_BASE_URL=https://openrouter.ai/api/v1              # OpenRouter
# LLM_BASE_URL=http://localhost:11434/v1                 # Ollama (local)
# LLM_BASE_URL=http://localhost:8000/v1                  # vLLM (local)
LLM_BASE_URL=

# Optional: model name. If unset, falls back to a sensible default
# per provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o-mini
# Common alternatives:
#   anthropic → claude-opus-4-7, claude-haiku-4-5
#   openai    → gpt-4o, gpt-4o-mini, o3-mini
#   deepseek  → deepseek-chat, deepseek-reasoner
#   moonshot  → moonshot-v1-8k, moonshot-v1-32k, kimi-k2-0905-preview
#   groq      → llama-3.1-70b-versatile, mixtral-8x7b-32768
#   ollama    → llama3.1, qwen2.5, mistral
LLM_MODEL=

# Toggle the planner. real | fake (rule-based, runs offline without an API key)
WATI_AGENT_LLM=real

# =====================================================================
# WATI API configuration
# =====================================================================
# mock = in-memory backend (works out of the box, seeded with sample data)
# real = call the live WATI sandbox (requires the three vars below)
WATI_AGENT_BACKEND=mock

WATI_TENANT_ID=
WATI_API_TOKEN=
WATI_BASE_URL=https://live-mt-server.wati.io
